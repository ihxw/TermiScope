#!/bin/bash
# TermiScope 监控代理一键安装脚本
# 主机: {{HOST_NAME}} (ID: {{HOST_ID}})
# 服务器: {{SERVER_URL}}

set -e

echo "========================================="
echo " TermiScope 监控代理安装程序"
echo "========================================="
echo "主机: {{HOST_NAME}}"
echo "服务器: {{SERVER_URL}}"
echo ""

# 检测操作系统和架构
OS_RAW=$(uname -s)
OS=$(echo "$OS_RAW" | tr 'A-Z' 'a-z')
ARCH=$(uname -m)

# 检测是否为容器
IS_CONTAINER=false
if [ -f /.dockerenv ] || grep -q 'docker\|lxc' /proc/1/cgroup 2>/dev/null; then
    IS_CONTAINER=true
fi

# 检测 sudo
SUDO=""
if [ "$(id -u)" -ne 0 ] && command -v sudo >/dev/null 2>&1; then
    SUDO="sudo"
fi


# 调试信息
# echo "Debug: uname -s returned '$OS_RAW', normalized to '$OS'"
IS_OPENWRT=false
IS_ALPINE=false

# 检测 OpenWrt
if [ -f "/etc/openwrt_release" ]; then
    IS_OPENWRT=true
fi

# 检测 Alpine Linux
if [ -f "/etc/alpine-release" ]; then
    IS_ALPINE=true
    echo "检测到 Alpine Linux"
fi

# 转换架构名称
case $ARCH in
    x86_64|amd64)
        ARCH="amd64"
        ;;
    aarch64|arm64)
        ARCH="arm64"
        ;;
    armv7l|armv7)
        ARCH="arm"
        ;;
    *)
        echo "错误: 不支持的架构 $ARCH"
        exit 1
        ;;
esac

# 设置变量
INSTALL_DIR="/opt/termiscope/agent"
if [ "$OS" != "darwin" ]; then
    for dir in "/opt" "/usr/local" "/var/lib" "/tmp"; do
        if mkdir -p "$dir/termiscope/agent" 2>/dev/null && touch "$dir/termiscope/agent/.test" 2>/dev/null; then
            rm -f "$dir/termiscope/agent/.test"
            INSTALL_DIR="$dir/termiscope/agent"
            break
        fi
    done
fi
BIN_NAME="termiscope-agent-$OS-$ARCH"
USE_SYSTEMD=false
USE_OPENRC=false
USE_INIT=true

if [ "$IS_CONTAINER" = true ]; then
    USE_INIT=false
fi

case $OS in
    linux)
        if [ "$IS_OPENWRT" = true ]; then
            SERVICE_FILE="/etc/init.d/termiscope-agent"
            # OpenWrt 通常空间较小，安装到 /usr/bin 或保持 /opt
        elif command -v systemctl >/dev/null 2>&1 && $SUDO systemctl show-environment >/dev/null 2>&1; then
            USE_SYSTEMD=true
            SERVICE_FILE="/etc/systemd/system/termiscope-agent.service"
        elif command -v rc-service >/dev/null 2>&1 && command -v rc-update >/dev/null 2>&1 && command -v openrc-run >/dev/null 2>&1; then
            USE_OPENRC=true
            SERVICE_FILE="/etc/init.d/termiscope-agent"
        else
            if [ "$USE_INIT" = true ]; then
                echo "错误: 未检测到可用的 systemd、OpenRC 或 OpenWrt 服务管理器。"
                exit 1
            fi
        fi
        ;;
    darwin)
        INSTALL_DIR="$HOME/Library/TermiScope/agent"
        SERVICE_FILE="$HOME/Library/LaunchAgents/com.termiscope.agent.plist"
        ;;
    *)
        # Fallback: check if it contains "linux" (case insensitive logic handled above)
        if echo "$OS" | grep -q "linux"; then
            echo "警告: 系统被识别为 $OS，尝试作为 Linux 处理..."
            OS="linux"
            # Re-run linux logic setup
            if [ "$IS_OPENWRT" = true ]; then
                SERVICE_FILE="/etc/init.d/termiscope-agent"
            elif command -v systemctl >/dev/null 2>&1 && $SUDO systemctl show-environment >/dev/null 2>&1; then
                USE_SYSTEMD=true
                SERVICE_FILE="/etc/systemd/system/termiscope-agent.service"
            elif command -v rc-service >/dev/null 2>&1 && command -v rc-update >/dev/null 2>&1 && command -v openrc-run >/dev/null 2>&1; then
                USE_OPENRC=true
                SERVICE_FILE="/etc/init.d/termiscope-agent"
            else
                if [ "$USE_INIT" = true ]; then
                    echo "错误: 未检测到可用的 systemd、OpenRC 或 OpenWrt 服务管理器。"
                    exit 1
                fi
            fi
        else
            echo "错误: 不支持的操作系统 $OS (Raw: $OS_RAW)"
            exit 1
        fi
        ;;
esac

echo "检测到系统: $OS ($ARCH)"
if [ "$IS_OPENWRT" = true ]; then
    echo "发行版: OpenWrt"
fi
echo "安装目录: $INSTALL_DIR"
echo ""

# 确保必要的依赖已安装
echo "[0/6] 检查和安装依赖..."
if ! command -v curl >/dev/null 2>&1; then
    if command -v apt-get >/dev/null 2>&1; then
        $SUDO apt-get update -qq
        $SUDO apt-get install -y curl ca-certificates
    elif command -v dnf >/dev/null 2>&1; then
        $SUDO dnf install -y curl ca-certificates
    elif command -v yum >/dev/null 2>&1; then
        $SUDO yum install -y curl ca-certificates
    elif command -v microdnf >/dev/null 2>&1; then
        $SUDO microdnf install -y curl ca-certificates
    elif command -v apk >/dev/null 2>&1; then
        $SUDO apk add --no-cache curl ca-certificates
    elif command -v pacman >/dev/null 2>&1; then
        $SUDO pacman -S --needed --noconfirm curl ca-certificates
    elif command -v zypper >/dev/null 2>&1; then
        $SUDO zypper --non-interactive install curl ca-certificates
    elif command -v opkg >/dev/null 2>&1; then
        $SUDO opkg update
        $SUDO opkg install curl ca-bundle
    else
        echo "错误: 未找到受支持的包管理器，请先安装 curl 和 CA 证书。"
        exit 1
    fi
    if ! command -v curl >/dev/null 2>&1; then
        echo "错误: curl 安装失败，请手动安装后重试。"
        exit 1
    fi
fi

# 创建安装目录
echo "[1/6] 创建安装目录..."
if [ "$OS" = "linux" ]; then
    # 尝试 sudo，如果失败（如 OpenWrt root 运行）则直接运行
    $SUDO mkdir -p "$INSTALL_DIR" 2>/dev/null || mkdir -p "$INSTALL_DIR"
else
    mkdir -p "$INSTALL_DIR"
fi

cd "$INSTALL_DIR"

# 停止旧服务（如果存在）
echo "[2/6] 停止已存在的服务（如果有）..."
if [ "$IS_OPENWRT" = true ]; then
    if [ -f /etc/init.d/termiscope-agent ]; then
        $SUDO /etc/init.d/termiscope-agent stop
        $SUDO /etc/init.d/termiscope-agent disable
    fi
elif [ "$USE_OPENRC" = true ]; then
    if $SUDO test -f /etc/init.d/termiscope-agent; then
        $SUDO rc-service termiscope-agent stop
    fi
elif [ "$USE_SYSTEMD" = true ]; then
    if $SUDO systemctl cat termiscope-agent >/dev/null 2>&1; then
        $SUDO systemctl stop termiscope-agent
    fi
elif [ "$OS" = "darwin" ]; then
    launchctl unload $SERVICE_FILE 2>/dev/null || true
fi

# 下载代理程序
echo "[3/6] 下载监控代理..."
DOWNLOAD_URL="{{SERVER_URL}}/api/monitor/agent/$BIN_NAME?host_id={{HOST_ID}}"
echo "下载地址: $DOWNLOAD_URL"

if [ "$OS" = "linux" ]; then
    # OpenWrt 可能没有 sudo
    if command -v $SUDO >/dev/null 2>&1; then
        $SUDO curl -f -L -H "Authorization: Bearer {{SECRET}}" -o termiscope-agent "$DOWNLOAD_URL" || {
            echo "错误: 下载失败，请检查服务器是否可访问"
            exit 1
        }
        $SUDO chmod +x termiscope-agent
    else
        curl -f -L -H "Authorization: Bearer {{SECRET}}" -o termiscope-agent "$DOWNLOAD_URL" || {
             echo "错误: 下载失败，请检查服务器是否可访问"
             exit 1
        }
        chmod +x termiscope-agent
    fi
else
    curl -f -L -H "Authorization: Bearer {{SECRET}}" -o termiscope-agent "$DOWNLOAD_URL" || {
        echo "错误: 下载失败，请检查服务器是否可访问"
        exit 1
    }
    chmod +x termiscope-agent
fi

# 写入或保留代理配置，安装参数只经标准输入传递。
CONFIG_FILE="$INSTALL_DIR/agent.json"
AGENT_PATH="$INSTALL_DIR/termiscope-agent"
AGENT_USAGE="$($SUDO "$AGENT_PATH" -h 2>&1 || true)"
write_agent_install_config() {
    cat <<'EOF_AGENT_CONFIG'
{"server_url":"{{SERVER_URL}}","secret":"{{SECRET}}","host_id":{{HOST_ID}},"transfer_port":61725}
EOF_AGENT_CONFIG
}
if printf '%s\n' "$AGENT_USAGE" | grep -Eq '^[[:space:]]+-write-config([[:space:]=]|$)'; then
    # 新代理保留已有互传授权、端口及其他配置，只更新安装连接信息。
    if ! write_agent_install_config | $SUDO "$AGENT_PATH" -write-config "$CONFIG_FILE" >/dev/null 2>&1; then
        echo "错误: 无法安全更新代理配置，已保留原配置；请检查配置格式及文件权限。"
        exit 1
    fi
elif $SUDO test -e "$CONFIG_FILE" || $SUDO test -L "$CONFIG_FILE"; then
    echo "错误: 下载的代理不支持保留已有配置，请升级服务端提供的代理后重试；原配置未修改。"
    exit 1
else
    # 旧代理仅允许全新安装；临时文件权限为 0600，互传沿用代理自身默认值。
    CONFIG_TEMP="$($SUDO mktemp "$INSTALL_DIR/.agent.json.XXXXXX")" || {
        echo "错误: 无法创建安全的代理配置临时文件。"
        exit 1
    }
    if ! $SUDO chmod 600 "$CONFIG_TEMP" || ! write_agent_install_config | $SUDO tee "$CONFIG_TEMP" >/dev/null; then
        $SUDO rm -f "$CONFIG_TEMP"
        echo "错误: 无法写入安全的代理配置。"
        exit 1
    fi
    # 同目录硬链接原子发布，若配置在检查后出现则拒绝替换。
    if ! $SUDO ln "$CONFIG_TEMP" "$CONFIG_FILE" 2>/dev/null; then
        $SUDO rm -f "$CONFIG_TEMP"
        echo "错误: 代理配置已存在或无法安全创建，原配置未修改。"
        exit 1
    fi
    $SUDO rm -f "$CONFIG_TEMP"
fi

# 创建服务
echo "[4/6] 创建系统服务..."
if [ "$USE_INIT" = false ]; then
    echo "检测到容器环境，跳过创建系统服务，生成启动脚本..."
    $SUDO tee "$INSTALL_DIR/start.sh" >/dev/null <<EOF_SCRIPT
#!/bin/sh
exec "$INSTALL_DIR/termiscope-agent" -config "$INSTALL_DIR/agent.json"
EOF_SCRIPT
    $SUDO chmod +x "$INSTALL_DIR/start.sh"
elif [ "$IS_OPENWRT" = true ]; then
    # OpenWrt procdinit script
    cat > $SERVICE_FILE <<EOF
#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

PROG=$INSTALL_DIR/termiscope-agent

start_service() {
    procd_open_instance
    procd_set_param command "\$PROG"
    procd_append_param command -config "$CONFIG_FILE"
    
    # 设置工作目录
    procd_set_param respawn \${respawn_threshold:-3600} \${respawn_timeout:-5} \${respawn_retry:-5}
    procd_set_param stdout 1 
    procd_set_param stderr 1 
    procd_close_instance
}
EOF
    chmod +x $SERVICE_FILE
elif [ "$USE_SYSTEMD" = true ]; then
    # Linux systemd 服务
    $SUDO tee $SERVICE_FILE > /dev/null <<EOF
[Unit]
Description=TermiScope Monitor Agent
After=network.target

[Service]
ExecStart=$INSTALL_DIR/termiscope-agent -config $CONFIG_FILE
Restart=always
User=root
WorkingDirectory=$INSTALL_DIR

[Install]
WantedBy=multi-user.target
EOF
elif [ "$OS" = "darwin" ]; then
    # macOS LaunchAgent
    mkdir -p $(dirname $SERVICE_FILE)
    cat > $SERVICE_FILE <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.termiscope.agent</string>
    <key>ProgramArguments</key>
    <array>
        <string>$INSTALL_DIR/termiscope-agent</string>
        <string>-config</string>
        <string>$INSTALL_DIR/agent.json</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>$INSTALL_DIR/agent.log</string>
    <key>StandardErrorPath</key>
    <string>$INSTALL_DIR/agent.error.log</string>
</dict>
</plist>
EOF
elif [ "$USE_OPENRC" = true ]; then
    # OpenRC 使用自身的后台进程和 PID 文件管理。
    $SUDO tee "$SERVICE_FILE" >/dev/null <<EOF
#!$(command -v openrc-run)

name="TermiScope Monitor Agent"
description="将此主机的系统数据上传到 TermiScope 服务器"
command="$INSTALL_DIR/termiscope-agent"
command_args="-config \"$CONFIG_FILE\""
pidfile="/var/run/termiscope-agent.pid"
directory="$INSTALL_DIR"

command_background=true

depend() {
    use dns
    need net
}

EOF
    $SUDO chmod +x "$SERVICE_FILE"
fi

# 启动服务
echo "[5/6] 启动监控服务..."
if [ "$USE_INIT" = false ]; then
    echo "正在容器中后台启动 agent..."
    nohup "$INSTALL_DIR/start.sh" > "$INSTALL_DIR/agent.log" 2>&1 &
    sleep 2
elif [ "$IS_OPENWRT" = true ]; then
    /etc/init.d/termiscope-agent enable
    /etc/init.d/termiscope-agent start
    
    echo ""
    echo "[6/6] 验证服务状态..."
    sleep 2
    # 检查进程是否存在
    if pgrep -f "termiscope-agent" > /dev/null; then
        echo "✓ 服务运行正常 (PID: $(pgrep -f termiscope-agent))"
    else
        echo "✗ 服务启动失败，请检查日志: logread | grep termiscope"
        exit 1
    fi
elif [ "$USE_OPENRC" = true ]; then
    $SUDO rc-update add termiscope-agent default
    $SUDO rc-service termiscope-agent start
    
    echo ""
    echo "[6/6] 验证服务状态..."
    sleep 2
    if $SUDO rc-service termiscope-agent status >/dev/null 2>&1; then
        echo "✓ 服务运行正常"
    else
        echo "✗ 服务启动失败，请检查日志: dmesg | grep termiscope"
        exit 1
    fi
elif [ "$USE_SYSTEMD" = true ]; then
    $SUDO systemctl daemon-reload
    $SUDO systemctl enable termiscope-agent
    $SUDO systemctl start termiscope-agent
    
    echo ""
    echo "[6/6] 验证服务状态..."
    sleep 2
    if $SUDO systemctl is-active --quiet termiscope-agent; then
        echo "✓ 服务运行正常"
    else
        echo "✗ 服务启动失败，请检查日志:"
        echo "  $SUDO systemctl status termiscope-agent"
        echo "  $SUDO journalctl -u termiscope-agent -n 50"
        exit 1
    fi
elif [ "$OS" = "darwin" ]; then
    launchctl load $SERVICE_FILE
    
    echo ""
    echo "[6/6] 验证服务状态..."
    sleep 2
    if launchctl list | grep -q com.termiscope.agent; then
        echo "✓ 服务运行正常"
    else
        echo "✗ 服务启动失败，请检查日志:"
        echo "  cat $INSTALL_DIR/agent.error.log"
        exit 1
    fi
fi

echo ""
echo "========================================="
echo " 安装完成！"
echo "========================================="
echo ""

if [ "$USE_INIT" = false ]; then
    echo "查看日志: cat $INSTALL_DIR/agent.log"
    echo "启动代理: $INSTALL_DIR/start.sh"
elif [ "$IS_OPENWRT" = true ]; then
    echo "查看服务状态: pgrep -a termiscope"
    echo "查看日志: logread | grep termiscope"
    echo "停止服务: /etc/init.d/termiscope-agent stop"
elif [ "$USE_OPENRC" = true ]; then
    echo "查看服务状态: $SUDO rc-service termiscope-agent status"
    echo "查看日志: dmesg | grep termiscope"
    echo "停止服务: $SUDO rc-service termiscope-agent stop"
elif [ "$USE_SYSTEMD" = true ]; then
    echo "查看服务状态: $SUDO systemctl status termiscope-agent"
    echo "查看日志: $SUDO journalctl -u termiscope-agent -f"
    echo "停止服务: $SUDO systemctl stop termiscope-agent"
else
    echo "查看服务状态: launchctl list | grep termiscope"
    echo "查看日志: cat $INSTALL_DIR/agent.log"
    echo "停止服务: launchctl unload $SERVICE_FILE"
fi
